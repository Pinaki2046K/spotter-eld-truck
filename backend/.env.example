# Backend -- copy to .env for local use, or set in the host's dashboard.
DEBUG=True
SECRET_KEY=change-me
# ALLOWED_HOSTS is derived automatically on Render; set it only off-platform.
# ALLOWED_HOSTS=your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional. Without it, routing falls back to the public OSRM demo server.
# ORS_API_KEY=

# Nominatim requires a descriptive User-Agent with a contact address.
# NOMINATIM_USER_AGENT=SpotterTripPlanner/1.0 (you@example.com)
